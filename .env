# Public Gateway used by development and production builds.
EXPO_PUBLIC_API_URL=https://api.thanhlelmtp2006.id.vn/api

# Local fallback used only when EXPO_PUBLIC_API_URL is not configured.
EXPO_PUBLIC_API_PORT=3000
EXPO_PUBLIC_API_PATH=/api

# Socket.IO is exposed by the same public Gateway domain.
EXPO_PUBLIC_SOCKET_URL=https://api.thanhlelmtp2006.id.vn
EXPO_PUBLIC_SOCKET_PATH=/socket.io
