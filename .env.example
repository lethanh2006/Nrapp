# Full API URL used by the app. Copy this file to .env.local and adjust it.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api

# Optional overrides
# EXPO_PUBLIC_API_TIMEOUT_MS=10000
# EXPO_PUBLIC_SOCKET_URL=http://192.168.1.10:3000
# EXPO_PUBLIC_SOCKET_PATH=/socket.io
# EXPO_PUBLIC_API_PORT=3000
# EXPO_PUBLIC_API_PATH=/api
